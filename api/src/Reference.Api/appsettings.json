{
  "AuthenticationServices": [
    {
      "Name": "Default",
      "ServiceOptionType": "OpenIddict",
      "Enabled": true,
      "Authority": "http://localhost:5020",
      "SecretManagerName": "EnvSecrets",
      "SecretKeyName": "AUTH_SIGNING_KEY"
    }
  ],
  "ApiClients": {
    "PipelineJobClient": {
      "BaseUrl": "http://localhost:5022/api/v1/"
    },
    "ScheduleClient": {
      "BaseUrl": "http://localhost:5024/api/v1/"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "System": "Warning",
        "OpenTelemetry": "Warning",
        "Fdw": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "app",
              "value": "fdw-api"
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Reference.Api"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Reference.Api",
    "Tracing": {
      "Enabled": true,
      "ExportToConsole": false
    },
    "Metrics": {
      "Enabled": true,
      "ExportToConsole": false
    }
  },
  "BootstrapSecretManager": {
    "Type": "EnvironmentVariable",
    "Prefix": "FDW_SECRET_",
    "StripPrefix": true
  },
  "ControlDb": {
    "Server": "MUST-CONFIGURE-IN-ENVIRONMENT",
    "Port": 1433,
    "Database": "ControlDb",
    "DefaultSchema": "cfg",
    "TrustServerCertificate": true,
    "Encrypt": true,
    "EnableMultipleActiveResultSets": true,
    "AuthenticationType": "SqlAuth",
    "Authentication": {
      "Type": "SqlAuth",
      "Username": "fdw_config",
      "SecretKeyName": "CONFIG_PASSWORD"
    }
  },
  "Authentication": {
    "Jwt": [
      {
        "Name": "Default",
        "Issuer": "Fdw.Reference.Api",
        "Audience": "Fdw.Reference.Api",
        "SecretKey": "",
        "AccessTokenExpirationMinutes": 60,
        "RefreshTokenExpirationMinutes": 10080,
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkewSeconds": 30,
        "RoleClaimType": "role",
        "NameClaimType": "name",
        "AvailableRoles": [
          "Admin",
          "Operator",
          "Viewer"
        ]
      }
    ]
  },
  "DataGateway": {
    "EnableCache": true
  },
  "AllowedHosts": "*",
  "_CorsNote": "Production must override Cors:Origins via appsettings.Production.json or environment variables",
  "Cors": {
    "Enabled": true,
    "Origins": [
      "https://localhost:5007",
      "http://localhost:5007"
    ],
    "Methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH",
      "OPTIONS"
    ],
    "Headers": [
      "Content-Type",
      "Authorization",
      "X-Requested-With",
      "X-Tenant-Id",
      "X-Correlation-Id"
    ],
    "ExposedHeaders": [
      "X-Correlation-Id",
      "X-Request-Id",
      "WWW-Authenticate",
      "X-RateLimit-Limit",
      "X-RateLimit-Remaining",
      "X-RateLimit-Reset"
    ],
    "AllowCredentials": true,
    "PreflightMaxAgeSeconds": 600
  },
  "SecurityHeaders": {
    "AllowFraming": false,
    "EnableDefaultCsp": true
  },
  "Support": {
    "Email": "support@example.com",
    "Phone": null,
    "PortalUrl": null,
    "ExpectedResponseTimeHours": 24,
    "Instructions": "If this error persists, please contact support with the Request ID above."
  },
  "ServiceEndpoints": {
    "Scheduler": "http://localhost:5004",
    "Etl": "http://localhost:5002"
  },
  "InternalApi": {
    "ApiKey": "dev-internal-api-key-change-in-production"
  },
  "CalculationCache": {
    "Enabled": true,
    "DefaultTtlMinutes": 60,
    "MaxTtlMinutes": 1440,
    "TtlByCalculationType": {
      "Sum": 30,
      "Average": 30,
      "Count": 15,
      "Min": 30,
      "Max": 30
    },
    "InvalidateOnDataChange": true,
    "WarmupOnStartup": false,
    "MaxCachedResultSizeBytes": 10485760,
    "Provider": "Memory",
    "KeyPrefix": "calc:"
  },
  "DesignerPipelines": {
    "StoragePath": "data/designer-pipelines"
  },
  "Connections": {
    "FileSystem": [
      {
        "Name": "LocalFs",
        "Root": "/var/lib/fdw/sources/"
      }
    ],
    "RoslynWorkspace": [
      {
        "Name": "RoslynWorkspaceLocal",
        "SolutionPath": "/opt/fdw/sources/FractalDataWorks.DeveloperKit.slnx",
        "ModeName": "Snapshot"
      }
    ]
  },
  "Users": {
    "CredentialServiceName": "CredentialService"
  },
  "CredentialsSql": {
    "CredentialServiceName": "CredentialService"
  },
  "authz": {
    "SystemRoleMapping": {
      "AdminRoleName": "Admin"
    }
  },
  "HealthMonitor": {
    "Name": "Default"
  },
  "HealthMonitors": [
    {
      "Name": "Default",
      "ServiceOptionType": "Local",
      "CheckIntervalSeconds": 30,
      "HistoryRetentionMinutes": 60,
      "ThroughputWindowSeconds": 300
    }
  ]
}
