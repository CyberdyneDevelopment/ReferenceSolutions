meta {
  name: Bootstrap - Assign Admin role to testAdmin
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/{{testAdminUserId}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "RoleName": "Admin"
  }
}

assert {
  res.status: in [200, 201, 409]
}
