meta {
  name: Bootstrap - Login as seeded admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/token
  body: json
  auth: none
}

body:json {
  {
    "Username": "{{adminUsername}}",
    "Password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.AccessToken: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("adminToken", res.body.AccessToken);
  }
}
