meta {
  name: Bootstrap - Login as testAdmin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/token
  body: json
  auth: none
}

body:json {
  {
    "Username": "{{testAdminUsername}}",
    "Password": "{{testAdminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.AccessToken: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("testAdminToken", res.body.AccessToken);
  }
}
