meta {
  name: Create TestApiRole
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testAdminToken}}
}

body:json {
  {
    "Name": "TestApiRole",
    "DisplayName": "Test API Role",
    "Description": "Role created by API E2E tests",
    "IsTenantScoped": false
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("createdRoleName", "TestApiRole");
  }
}
