  token: {{testAdminToken}}
}

body:json {
  {
    "Name": "TestApiDataSet",
    "Description": "Updated test dataset",
    "Category": "IntegrationTest",
    "Version": "2.0",
    "RecordTypeName": "TestRecord",
    "KeyFields": ["Id"]
  }
}

assert {
  res.status: eq 200
}
