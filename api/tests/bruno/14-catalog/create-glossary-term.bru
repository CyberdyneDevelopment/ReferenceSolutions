meta {
  name: Create glossary term
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/catalog/glossary
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testAdminToken}}
}

body:json {
  {
    "Name": "TestGlossaryTerm",
    "Definition": "A test term created by the API E2E test suite",
    "Category": "Testing",
    "Owner": "testAdmin",
    "RelatedDataSets": ["Schedules"]
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body.Id) {
    bru.setVar("glossaryTermId", res.body.Id);
  } else if (res.body.id) {
    bru.setVar("glossaryTermId", res.body.id);
  }
}
