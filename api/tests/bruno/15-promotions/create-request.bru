meta {
  name: Create promotion request
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/promotion/requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testAdminToken}}
}

body:json {
  {
    "SourceEnvironment": "Development",
    "TargetEnvironment": "Staging",
    "EntityTypes": ["Pipeline"],
    "EntityNames": ["DataArchiveCopy"],
    "RequestedBy": "testAdmin"
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body.Id) {
    bru.setVar("promotionId", res.body.Id);
  } else if (res.body.id) {
    bru.setVar("promotionId", res.body.id);
  }
}
