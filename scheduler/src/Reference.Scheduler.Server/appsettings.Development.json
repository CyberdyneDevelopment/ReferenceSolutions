{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Fdw": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "fdw-scheduler" }
          ]
        }
      }
    ]
  },
  "OpenTelemetry": {
    "Tracing": {
      "Enabled": true,
      "ExportToConsole": true
    },
    "Metrics": {
      "Enabled": true,
      "ExportToConsole": true
    }
  }
}
