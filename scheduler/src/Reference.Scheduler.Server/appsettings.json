{
  "AuthenticationServices": [
    {
      "Name": "Default",
      "ServiceOptionType": "OpenIddict",
      "Enabled": true,
      "Authority": "http://localhost:5020",
      "SecretManagerName": "EnvSecrets",
      "SecretKeyName": "AUTH_SIGNING_KEY"
    }
  ],
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5004"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "System": "Warning",
        "OpenTelemetry": "Warning",
        "Fdw": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "app",
              "value": "fdw-scheduler"
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Reference.Scheduler.Server"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Reference.Scheduler.Server",
    "Tracing": {
      "Enabled": true,
      "ExportToConsole": false
    },
    "Metrics": {
      "Enabled": true,
      "ExportToConsole": false
    }
  },
  "BootstrapSecretManager": {
    "Type": "EnvironmentVariable",
    "Prefix": "FDW_SECRET_",
    "StripPrefix": true
  },
  "ControlDb": {
    "Server": "MUST-CONFIGURE-IN-ENVIRONMENT",
    "Port": 1433,
    "Database": "ControlDb",
    "DefaultSchema": "cfg",
    "TrustServerCertificate": true,
    "Encrypt": true,
    "EnableMultipleActiveResultSets": true,
    "AuthenticationType": "SqlAuth",
    "Authentication": {
      "Type": "SqlAuth",
      "Username": "fdw_config_ro",
      "SecretKeyName": "CONFIG_RO_PASSWORD"
    }
  },
  "Scheduler": {
    "EvaluationIntervalSeconds": 60
  },
  "EtlDispatch": {
    "Enabled": true,
    "BaseUrl": "http://localhost:5002",
    "TimeoutSeconds": 30
  },
  "OutboundClientCredentials": {
    "ClientId": "fdw.scheduler",
    "SecretManagerName": "EnvSecrets",
    "SecretKeyName": "SCHEDULER_CLIENT_SECRET",
    "Scopes": [
      "fdw.api"
    ]
  },
  "PreCompute": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "InitialDelayMinutes": 5,
    "StalenessThresholdMinutes": 30,
    "MaxCalculationsPerRun": 50,
    "PreComputedTtlMinutes": 120,
    "DelayBetweenCalculationsMs": 500,
    "MinExecutionCountThreshold": 5,
    "ApiBaseUrl": "https://localhost:5001"
  },
  "InternalApi": {
    "ApiKey": "dev-internal-api-key-change-in-production"
  },
  "DataGateway": {
    "EnableCache": false
  },
  "AllowedHosts": "*",
  "authz": {
    "SystemRoleMapping": {
      "AdminRoleName": "Admin"
    }
  }
}
