<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fdw.Services.Multitenancy.Abstractions" />
    <ProjectReference Include="..\FdwReferenceConnections.FileSystem.Abstractions\FdwReferenceConnections.FileSystem.Abstractions.csproj" />
    <PackageReference Include="Fdw.Services.Connections.Abstractions" />
    <PackageReference Include="Fdw.Services.Connections" />
    <PackageReference Include="Fdw.Configuration.Abstractions" />
    <PackageReference Include="Fdw.MessageLogging.Abstractions" />
    <PackageReference Include="Fdw.MessageLogging.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.Collections.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.Configuration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.Data.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.Results" />
    <PackageReference Include="Fdw.Results.Abstractions" />
    <PackageReference Include="Fdw.Data.Abstractions" />
    <PackageReference Include="Fdw.Data.DataSets.Abstractions" />
    <PackageReference Include="Fdw.Services.Data.Abstractions" />
    <PackageReference Include="Fdw.Services.Data" />
    <PackageReference Include="Fdw.Services.Abstractions" />
    <PackageReference Include="Fdw.Services.Authorization.Abstractions" />
    <PackageReference Include="Fdw.Messages" />
    <PackageReference Include="Fdw.Collections" />
    <PackageReference Include="Fdw.Services" />
    <PackageReference Include="Fdw.Data.RowSources" />
    <PackageReference Include="Fdw.Data.RowSources.Abstractions" />
    <PackageReference Include="Fdw.Data.RowSources.FixedWidth.Abstractions" />
    <PackageReference Include="Fdw.Data.DataNodes" />
    <ProjectReference Include="..\FdwReferenceData.FileSystem\FdwReferenceData.FileSystem.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FdwReferenceConnections.FileSystem.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>
</Project>
