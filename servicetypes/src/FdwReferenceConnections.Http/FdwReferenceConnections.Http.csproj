<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <Description>Http connection — the aggregation over FDW's Http dialect, translators and components, plus its service type registration.</Description>
  </PropertyGroup>

  <!-- Why: a connection is a COMPOSITION. The dialect, translators, converters, native types,
       error handlers and limits are framework machinery and stay in FDW; this package is the
       composition over them and the service-type surface that registers it. -->
  <ItemGroup>
    <PackageReference Include="Fdw.Commands.Data" />
    <PackageReference Include="Fdw.Commands.Data.Abstractions" />
    <PackageReference Include="Fdw.Configuration" />
    <PackageReference Include="Fdw.Data" />
    <PackageReference Include="Fdw.Data.Abstractions" />
    <PackageReference Include="Fdw.Data.DataContainers.Abstractions" />
    <PackageReference Include="Fdw.Data.DataNodes" />
    <PackageReference Include="Fdw.Data.DataSets" />
    <PackageReference Include="Fdw.Data.Files" />
    <PackageReference Include="Fdw.Data.Http" />
    <PackageReference Include="Fdw.Data.RowSources" />
    <PackageReference Include="Fdw.Data.RowSources.Abstractions" />
    <PackageReference Include="Fdw.Data.RowSources.FixedWidth.Abstractions" />
    <PackageReference Include="Fdw.MessageLogging.Abstractions" />
    <PackageReference Include="Fdw.Results" />
    <PackageReference Include="Fdw.Results.Abstractions" />
    <PackageReference Include="Fdw.Services" />
    <PackageReference Include="Fdw.Services.Abstractions" />
    <PackageReference Include="Fdw.Services.Connections" />
    <PackageReference Include="Fdw.Services.Connections.Abstractions" />
    <PackageReference Include="Fdw.Services.Connections.Http" />
    <PackageReference Include="Fdw.Services.Connections.Http.Abstractions" />
    <PackageReference Include="Fdw.Services.Data" />
    <PackageReference Include="Fdw.Services.Data.Abstractions" />
    <PackageReference Include="Fdw.Services.SecretManagers" />
    <PackageReference Include="Fdw.Services.SecretManagers.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Collections.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.Configuration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.Data.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.MessageLogging.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

</Project>
