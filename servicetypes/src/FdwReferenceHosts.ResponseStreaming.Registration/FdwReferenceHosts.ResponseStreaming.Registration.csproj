<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FdwReferenceHosts.ResponseStreaming.Registration</RootNamespace>
    <PackageId>FdwReferenceHosts.ResponseStreaming.Registration</PackageId>
    <Description>The response-streaming host-option registration: the [Implementation] only. References the implementation, so referencing THIS package brings the implementation with it and registers the option.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Collections" />
    <PackageReference Include="Fdw.Services.Data.Endpoints" />
    <PackageReference Include="Fdw.Services.Hosts" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why the implementation and not the reverse: referencing the implementation gets you its
         configuration record with no registration; referencing this package gets you the
         registration as well. Registration is opt-in, so a library can depend on the
         implementation without silently registering an option into its consumer's collection. -->
    <ProjectReference Include="..\FdwReferenceHosts.ResponseStreaming\FdwReferenceHosts.ResponseStreaming.csproj" />
  </ItemGroup>

</Project>
