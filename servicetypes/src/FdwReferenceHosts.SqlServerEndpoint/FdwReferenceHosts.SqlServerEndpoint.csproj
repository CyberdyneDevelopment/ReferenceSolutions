<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FdwReferenceHosts.SqlServerEndpoint</RootNamespace>
    <PackageId>FdwReferenceHosts.SqlServerEndpoint</PackageId>
    <Description>The SQL Server endpoint host option: its configuration record, the command that reads it, and the source that turns the row and its secrets into the listener's options.</Description>
    <IsPackable>true</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Configuration.Abstractions" />
    <PackageReference Include="Fdw.Data.Abstractions" />
    <PackageReference Include="Fdw.MessageLogging.Abstractions" />
    <PackageReference Include="Fdw.Messages" />
    <PackageReference Include="Fdw.Results" />
    <PackageReference Include="Fdw.Services" />
    <PackageReference Include="Fdw.Services.Hosts.Abstractions" />
    <PackageReference Include="Fdw.Services.SecretManagers" />
    <PackageReference Include="Fdw.Services.SecretManagers.Abstractions" />
    <PackageReference Include="Fdw.Tds.Endpoints" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Configuration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.Data.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.MessageLogging.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
