<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>FdwReferenceSchedulers.Hangfire.Registration</RootNamespace>

    <PackageId>FdwReferenceSchedulers.Hangfire.Registration</PackageId>
    <Description>The Hangfire scheduler service-type registration: the [Implementation] only. References the implementation, so referencing THIS package brings the implementation with it and registers the option.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Why the implementation and not the reverse: referencing the implementation gets you its
         factory, service and configuration with no registration; referencing this package gets you
         the registration as well. Registration is opt-in, so a library can depend on the
         implementation without silently registering an option into its consumer's collection. -->
    <ProjectReference Include="..\FdwReferenceSchedulers.Hangfire\FdwReferenceSchedulers.Hangfire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.SqlServer" />
    <!-- AddHangfire/AddHangfireServer DI extensions live here, not in Hangfire.Core. -->
    <PackageReference Include="Hangfire.AspNetCore" />
  </ItemGroup>

</Project>
