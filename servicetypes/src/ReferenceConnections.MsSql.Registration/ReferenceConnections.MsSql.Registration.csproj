<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <Description>The MsSql service-type registration: the [ServiceTypeOption] and its configuration provider. References the aggregation package, so referencing THIS package brings the aggregation with it.</Description>
  </PropertyGroup>

  <!-- Why: a reference to the service-type package must transitively bring the aggregation —
       consumers only need to reference ReferenceConnections.MsSql.Registration to get both the
       registration surface and the underlying MsSql connection composition it registers. -->
  <ItemGroup>
    <ProjectReference Include="..\ReferenceConnections.MsSql\ReferenceConnections.MsSql.csproj" />
  </ItemGroup>

  <!-- Why the package list mirrors the aggregation's: this package compiles the [ServiceTypeOption]
       and its configuration provider against the same FDW abstractions the composition is built from.
       The composition itself lives in ReferenceConnections.MsSql, referenced above. -->
  <ItemGroup>
    <PackageReference Include="Fdw.Collections" />
    <PackageReference Include="Fdw.Commands.Data.Abstractions" />
    <PackageReference Include="Fdw.Configuration.Abstractions" />
    <PackageReference Include="Fdw.Data.Abstractions" />
    <PackageReference Include="Fdw.Data.DataNodes" />
    <PackageReference Include="Fdw.Data.DataSets" />
    <PackageReference Include="Fdw.Data.MsSql" />
    <PackageReference Include="Fdw.Data.RowSources.Abstractions" />
    <PackageReference Include="Fdw.MessageLogging.Abstractions" />
    <PackageReference Include="Fdw.Messages" />
    <PackageReference Include="Fdw.Results" />
    <PackageReference Include="Fdw.Results.Abstractions" />
    <PackageReference Include="Fdw.Services" />
    <PackageReference Include="Fdw.Services.Authentication.Abstractions" />
    <PackageReference Include="Fdw.Services.Connections" />
    <PackageReference Include="Fdw.Services.Connections.Abstractions" />
    <PackageReference Include="Fdw.Services.Connections.MsSql" />
    <PackageReference Include="Fdw.Services.Connections.Sql" />
    <PackageReference Include="Fdw.Services.Data" />
    <PackageReference Include="Fdw.Services.Data.Abstractions" />
    <PackageReference Include="Fdw.Services.SecretManagers" />
    <PackageReference Include="Fdw.Types.MsSql" />
    <PackageReference Include="Fdw.Validation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Collections.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.Configuration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.Data.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.MessageLogging.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Why no InternalsVisibleTo here: the seams those suites exercise (BuildSessionContextPlan,
       CreatePooledConnection, SetUserSessionContext) are internals of MsSqlConnection, which lives
       in ReferenceConnections.MsSql and grants them there. This project declares no internals, so
       the grant it used to carry — copy-pasted from the aggregation — did nothing. -->

</Project>
