<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <Description>Sql credential service — the aggregation over FDW's Credentials machinery, plus its service type registration.</Description>
  </PropertyGroup>

  <!-- Why: the AGGREGATION lives here; the components it composes stay in FDW. Reference
       implementations get NO InternalsVisibleTo — anything needed to compose this service
       has to be public API. See fractaldataworks 7201fb0fa. -->
  <ItemGroup>
    <PackageReference Include="Fdw.Abstractions" />
    <PackageReference Include="Fdw.Collections" />
    <PackageReference Include="Fdw.Commands.Data" />
    <PackageReference Include="Fdw.Commands.Data.Extensions" />
    <PackageReference Include="Fdw.Configuration" />
    <PackageReference Include="Fdw.Configuration.Abstractions" />
    <PackageReference Include="Fdw.Data.Abstractions" />
    <PackageReference Include="Fdw.MessageLogging.Abstractions" />
    <PackageReference Include="Fdw.Messages" />
    <PackageReference Include="Fdw.Results" />
    <PackageReference Include="Fdw.Security.Hashing" />
    <PackageReference Include="Fdw.Services" />
    <PackageReference Include="Fdw.Services.Abstractions" />
    <PackageReference Include="Fdw.Services.Authentication.Abstractions" />
    <PackageReference Include="Fdw.Services.Connections.Abstractions" />
    <PackageReference Include="Fdw.Services.Connections.MsSql" />
    <PackageReference Include="Fdw.Services.Credentials.Abstractions" />
    <PackageReference Include="Fdw.Services.Credentials.Sql" />
    <PackageReference Include="Fdw.Services.Data.Abstractions" />
    <PackageReference Include="Fdw.Services.DataVault.Abstractions" />
    <PackageReference Include="Fdw.Services.SecretManagers" />
    <PackageReference Include="Fdw.Services.SecretManagers.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Collections.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.Configuration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.Data.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.MessageLogging.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
