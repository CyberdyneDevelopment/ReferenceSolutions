<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>The reference API's host service type: the values this deployment supplies to the framework's API surface — its document title, its public origins, and its OAuth client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Hosting" />
    <PackageReference Include="Fdw.Web.RestEndpoints" />
    <PackageReference Include="Fdw.Collections" />
    <PackageReference Include="Fdw.Results" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Why: MSBuildWorkspace arrives transitively through the Roslyn connection and pins
         Microsoft.Build.Framework + Microsoft.NET.StringTools. Microsoft.Build.Locator refuses
         (MSBL001) any Microsoft.Build.* reference not marked runtime-excluded, because loading a
         second copy of MSBuild's assemblies at run time breaks its resolver. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
