    <!-- Why: MSBuildWorkspace arrives transitively through the Roslyn connection and pins
         Microsoft.Build.Framework + Microsoft.NET.StringTools. Microsoft.Build.Locator refuses
         (MSBL001) any Microsoft.Build.* reference not marked runtime-excluded, because loading a
         second copy of MSBuild's assemblies at run time breaks its resolver. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

