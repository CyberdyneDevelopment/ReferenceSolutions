    </PackageReference>
    <PackageReference Include="Fdw.Data.SourceGenerators">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fdw.MessageLogging.Abstractions" />
    <PackageReference Include="Fdw.MessageLogging.SourceGenerators" />
    <PackageReference Include="Fdw.Messages" />
    <PackageReference Include="Fdw.Results" />
    <PackageReference Include="Fdw.Results.Abstractions" />
    <PackageReference Include="Fdw.Services" />
    <PackageReference Include="Fdw.Services.Authentication" />
    <PackageReference Include="Fdw.Services.Authentication.Abstractions" />
