<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Sign-in type: password login. Brings in the steps a PasswordLogin flow needs -- PasswordCredential, BakePermissions, AuthorizeSignInMethod, AuthorizeIssuance -- so a host references one package instead of four. No code of its own: referencing this package is the registration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FdwReferenceAuthentication.PasswordCredential.Registration\FdwReferenceAuthentication.PasswordCredential.Registration.csproj" />
    <ProjectReference Include="..\FdwReferenceAuthentication.BakePermissions.Registration\FdwReferenceAuthentication.BakePermissions.Registration.csproj" />
    <ProjectReference Include="..\FdwReferenceAuthentication.AuthorizeIssuance.Registration\FdwReferenceAuthentication.AuthorizeIssuance.Registration.csproj" />
    <ProjectReference Include="..\FdwReferenceAuthentication.AuthorizeSignInMethod.Registration\FdwReferenceAuthentication.AuthorizeSignInMethod.Registration.csproj" />
  </ItemGroup>

</Project>
