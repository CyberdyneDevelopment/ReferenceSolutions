<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The wire half. This project is the only place that may open a real connection: everything
         above it goes through the gateway, which is why the service type lives in its own project
         and this one carries the provider dependency. -->
    <PackageReference Include="Fdw.Services.Connections" />
    <PackageReference Include="Fdw.Services.Connections.Abstractions" />
    <PackageReference Include="Fdw.Services.Abstractions" />
    <PackageReference Include="Fdw.Results" />
  </ItemGroup>

</Project>
