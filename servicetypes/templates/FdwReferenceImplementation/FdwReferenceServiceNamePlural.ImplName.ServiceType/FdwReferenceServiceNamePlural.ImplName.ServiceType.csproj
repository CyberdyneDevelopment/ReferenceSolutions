<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <Description>ImplName ServiceName service-type registration — the [Implementation] that registers the aggregation. Reference THIS package to register ImplName; it brings the aggregation transitively.</Description>
  </PropertyGroup>

  <!-- Why: a package reference IS a registration. This project exists so a consumer can choose:
       reference the aggregation alone to compose the service and pay for no DI, or reference this
       to actually enlist the ServiceNamePlural domain. The dependency only ever points this way. -->
  <ItemGroup>
    <ProjectReference Include="..\FdwReferenceServiceNamePlural.ImplName\FdwReferenceServiceNamePlural.ImplName.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Collections" />
    <PackageReference Include="Fdw.Configuration.Abstractions" />
    <PackageReference Include="Fdw.Services" />
    <PackageReference Include="Fdw.Services.Abstractions" />
    <PackageReference Include="Fdw.Services.ServiceNamePlural" />
    <PackageReference Include="Fdw.Services.ServiceNamePlural.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Collections.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fdw.Configuration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
