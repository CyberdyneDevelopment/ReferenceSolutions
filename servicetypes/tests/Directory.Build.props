<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress the verbose pruning output -->
    <NuGetPruneVerbosity>quiet</NuGetPruneVerbosity>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <IsTestProject>true</IsTestProject>
    <LangVersion>preview</LangVersion>

    <!-- Code Coverage: use coverlet.collector via "dotnet test" with XPlat Code Coverage -->
    <!-- See coverlet.runsettings for collector configuration -->
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- Shouldly for assertions -->
    <PackageReference Include="Shouldly" />

    <!-- Coverlet for code coverage (collector mode) -->
    <PackageReference Include="coverlet.collector" />

    <!-- JUnit test logger: required by the shared ci-components dotnet-package test job,
         which invokes the junit logger via dotnet test. Without it every CI test run
         aborts with "Could not find a test logger 'junit'" and pack/publish are skipped. -->
    <PackageReference Include="JunitXml.TestLogger" />

    <!-- Microsoft Test SDK -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />

    <!-- Moq for mocking -->
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="Moq" />
  </ItemGroup>

  <!-- Local NuGet Development Configuration (inherits IsLocalConfiguration from parent) -->
  <PropertyGroup>
    <!-- Default config filename - can be overridden in project files -->
    <LocalNugetConfigFileName Condition="'$(LocalNugetConfigFileName)' == ''">Fdw.Local.nuget.config</LocalNugetConfigFileName>
  </PropertyGroup>

  <!-- Use local NuGet config when using a -Local configuration and LocalNugetFolder is set -->
  <PropertyGroup Condition="'$(IsLocalConfiguration)' == 'true' AND '$(LocalNugetFolder)' != ''">
    <RestoreConfigFile>$(LocalNugetFolder)\$(LocalNugetConfigFileName)</RestoreConfigFile>
  </PropertyGroup>

  <!--
    The connection-role holders (PlatformConnection, ServerConnection, AuthConnection) have no default: a host declares
    its roles in configurationSchema.json. Tests that read a holder declare the same roles through this shared file,
    compiled in only where the project can see the holders. A holder is process-wide and takes one name per process,
    so a project whose tests run a host's own declaration (its schema's ConnectionRoles) sets
    <DeclaresItsOwnConnectionRoles>true</DeclaresItsOwnConnectionRoles> and does not get the stand-in.
  -->
  <Target Name="IncludeTestConnectionRoles" BeforeTargets="CoreCompile" DependsOnTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <_ConnectionRolesReference Include="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'Fdw.Services.Data.Abstractions'" />
    </ItemGroup>
    <ItemGroup Condition="'@(_ConnectionRolesReference)' != '' AND '$(DeclaresItsOwnConnectionRoles)' != 'true'">
      <Compile Include="$(MSBuildThisFileDirectory)Shared/TestConnectionRoles.cs" Link="TestConnectionRoles.cs" />
    </ItemGroup>
  </Target>
</Project>
