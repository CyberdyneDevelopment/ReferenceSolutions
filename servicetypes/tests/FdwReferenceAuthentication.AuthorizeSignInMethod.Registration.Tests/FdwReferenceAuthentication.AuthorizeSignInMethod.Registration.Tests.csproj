<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FdwReferenceAuthentication.AuthorizeSignInMethod.Registration\FdwReferenceAuthentication.AuthorizeSignInMethod.Registration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Why scoped to this assembly: coverage is only meaningful over the code this project tests.
       Including the whole graph would report FDW's coverage as if it were ours. -->
  <PropertyGroup>
    <Include>[FdwReferenceAuthentication.AuthorizeSignInMethod.Registration]*</Include>
    <Exclude>[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
