<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fdw.Claims.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="..\..\src\FdwReferenceMultitenancy.Sql\FdwReferenceMultitenancy.Sql.csproj" />
    <PackageReference Include="Fdw.Messages" />
    <!-- Why: a test that exercises a real config-provider Get() needs the module initializer that
         registers the cross-assembly SqlTenantProviderConfigurationCommand [TypeOption] into
         ConfigurationCommands — without it ConfigurationCommands.All() is empty and Commands() throws. -->
    <PackageReference Include="Fdw.Registration.SourceGenerators" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FdwReferenceMultitenancy.Sql.Registration\FdwReferenceMultitenancy.Sql.Registration.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Why both: the HTTP middleware moved to FdwReferenceMultitenancy (it names no storage), but
         its tests stay here because they build fixtures from SqlTenant. Covering only the .Sql
         assembly would report the middleware as untested while its tests run in this project. -->
    <Include>[FdwReferenceMultitenancy.Sql]*,[FdwReferenceMultitenancy]*</Include>
    <Exclude>[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
