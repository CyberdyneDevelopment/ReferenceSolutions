<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ReferenceAuthentication.TokenProviders\ReferenceAuthentication.TokenProviders.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Why scoped to this assembly: coverage is only meaningful over the code this project tests.
       Including the whole graph would report FDW's coverage as if it were ours. -->
  <PropertyGroup>
    <Include>[ReferenceAuthentication.TokenProviders]*</Include>
    <Exclude>[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
