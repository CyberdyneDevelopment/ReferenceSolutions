<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="..\..\src\ReferenceMultitenancy.Sql\ReferenceMultitenancy.Sql.csproj" />
    <PackageReference Include="Fdw.Messages" />
    <!-- Why: a test that exercises a real config-provider Get() needs the module initializer that
         registers the cross-assembly SqlTenantProviderConfigurationCommand [TypeOption] into
         ConfigurationCommands — without it ConfigurationCommands.All() is empty and Commands() throws. -->
    <PackageReference Include="Fdw.Registration.SourceGenerators" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Only include Fdw.Services.Multitenancy.Sql in coverage -->
    <Include>[Fdw.Services.Multitenancy.Sql]*</Include>
    <Exclude>[xunit.*]*,[Moq]*,[Shouldly]*</Exclude>
  </PropertyGroup>
</Project>
