@namespace Reference.Management.UI.Tailwind.Components.Domain.Tenants
@using Microsoft.AspNetCore.Components
@using System

@* Why: Tailwind skin for the profile dropdown. No logic here — all state and callbacks
   come from ProfileDropdownProvider via the context. Click-away uses a full-screen
   transparent overlay so the dropdown closes when the user clicks elsewhere. *@

<ProfileDropdownProvider>
    <ChildContent Context="ctx">
        <div class="relative">
            @* Avatar / initials button *@
            <button type="button"
                    class="flex items-center gap-2 px-2 py-1 text-gray-400 hover:text-gray-200 transition-colors focus:outline-none"
                    @onclick="async () => await ctx.OnToggle()">
                <div class="w-8 h-8 flex items-center justify-center bg-red-500/20 border border-red-500/40 text-red-400 text-xs font-bold uppercase tracking-wider">
                    @ctx.Initials
                </div>
                @if (!string.IsNullOrEmpty(ctx.UserName))
                {
                    <span class="hidden sm:block text-xs font-mono text-gray-300 max-w-[120px] truncate">
                        @ctx.UserName
                    </span>
                }
                <svg class="w-3 h-3 @(ctx.IsOpen ? "rotate-180" : "") transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            @if (ctx.IsOpen)
            {
                @* Click-away overlay — transparent full-screen backdrop *@
                <div class="fixed inset-0 z-40"
                     @onclick="() => ctx.OnClose()"
                     aria-hidden="true">
                </div>

                @* Dropdown panel *@
                <div class="absolute right-0 top-full mt-1 w-72 z-50 border border-gray-700 bg-[#0a0d12]/95 backdrop-blur shadow-2xl shadow-black/60">

                    @* Error banner *@
                    @if (!string.IsNullOrEmpty(ctx.ErrorMessage))
                    {
                        <div class="px-4 py-2 bg-red-900/30 border-b border-red-500/30 text-red-400 text-xs">
                            @ctx.ErrorMessage
                        </div>
                    }

                    @* User info section *@
                    <div class="px-4 py-3 border-b border-gray-700">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 flex items-center justify-center bg-red-500/20 border border-red-500/40 text-red-400 text-sm font-bold uppercase shrink-0">
                                @ctx.Initials
                            </div>
                            <div class="min-w-0">
                                <div class="text-sm font-medium text-gray-200 truncate">@ctx.UserName</div>
                                @if (!string.IsNullOrEmpty(ctx.UserEmail))
                                {
                                    <div class="text-xs text-gray-500 truncate font-mono">@ctx.UserEmail</div>
                                }
                            </div>
                        </div>
                        @* Active tenant + role info *@
                        <div class="mt-2 flex items-center gap-2 text-xs font-mono">
                            @if (ctx.IsCrossTenantMode)
                            {
                                <span class="badge badge-running">CROSS-TENANT</span>
                            }
                            else if (!string.IsNullOrEmpty(ctx.ActiveTenantName))
                            {
                                <span class="text-gray-500">TENANT:</span>
                                <span class="text-gray-300 truncate max-w-[140px]">@ctx.ActiveTenantName</span>
                            }
                            @if (!string.IsNullOrEmpty(ctx.Role))
                            {
                                <span class="ml-auto badge badge-idle">@ctx.Role</span>
                            }
                        </div>
                    </div>

                    @* Tenant switcher section — only for multi-tenant users *@
                    @if (ctx.ShowTenantSwitcher)
                    {
                        <div class="border-b border-gray-700">
                            <div class="px-4 py-2 text-[10px] text-gray-500 uppercase tracking-widest font-mono">Switch Tenant</div>
                            <div class="max-h-48 overflow-y-auto no-scrollbar">
                                @foreach (var tenant in ctx.Tenants)
                                {
                                    var isActive = ctx.ActiveTenantId == tenant.Id;
                                    var isDefault = ctx.DefaultTenantId == tenant.Id;
                                    <div class="flex items-center gap-2 px-4 py-2 hover:bg-gray-800/60 cursor-pointer group @(isActive ? "bg-red-500/10" : "")">
                                        @* Tenant name — click to switch *@
                                        <button type="button"
                                                class="flex-1 flex items-center gap-2 text-left text-sm @(isActive ? "text-red-400" : "text-gray-300 hover:text-gray-100") disabled:opacity-50"
                                                disabled="@(isActive || ctx.IsLoading)"
                                                @onclick="async () => await ctx.OnSwitchTenant(tenant.Id)">
                                            @if (isActive)
                                            {
                                                <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <span class="w-3 h-3 shrink-0"></span>
                                            }
                                            <span class="truncate">@tenant.Name</span>
                                            @if (isDefault)
                                            {
                                                <span class="ml-1 text-[10px] text-yellow-500 font-mono uppercase">DEFAULT</span>
                                            }
                                        </button>
                                        @* Set as default — hidden unless hovered *@
                                        @if (!isDefault && !ctx.IsLoading)
                                        {
                                            <button type="button"
                                                    class="opacity-0 group-hover:opacity-100 text-[10px] text-gray-500 hover:text-yellow-400 font-mono uppercase tracking-wider transition-opacity"
                                                    title="Set as default"
                                                    @onclick="async () => await ctx.OnSetDefaultTenant(tenant.Id)">
                                                DEFAULT
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Cross-tenant option — only for users with tenants:view-all *@
                    @if (ctx.ShowCrossTenantOption)
                    {
                        <div class="border-b border-gray-700">
                            <button type="button"
                                    class="w-full flex items-center gap-2 px-4 py-2 text-sm text-gray-300 hover:bg-gray-800/60 hover:text-cyan-400 disabled:opacity-50"
                                    disabled="@(ctx.IsLoading || ctx.IsCrossTenantMode)"
                                    @onclick="async () => await ctx.OnEnterCrossTenantMode()">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                                </svg>
                                <span>View all tenants</span>
                                @if (ctx.IsCrossTenantMode)
                                {
                                    <span class="ml-auto text-[10px] text-cyan-500 font-mono">ACTIVE</span>
                                }
                            </button>
                        </div>
                    }

                    @* Actions section *@
                    <div class="py-1">
                        <a href="/profile"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-300 hover:bg-gray-800/60 hover:text-gray-100 transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Profile &amp; Settings
                        </a>
                        <a href="/auth/logout"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Logout
                        </a>
                    </div>

                    @* Loading indicator *@
                    @if (ctx.IsLoading)
                    {
                        <div class="px-4 py-2 border-t border-gray-700/50 flex items-center gap-2 text-xs text-gray-500 font-mono">
                            <div class="w-2 h-2 bg-red-500 animate-pulse rounded-full"></div>
                            Processing...
                        </div>
                    }
                </div>
            }
        </div>
    </ChildContent>
</ProfileDropdownProvider>
