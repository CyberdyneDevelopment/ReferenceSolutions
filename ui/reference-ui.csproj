<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Reference.Management.UI.Tailwind</RootNamespace>
    <!-- Required for .NET 10: Ensures blazor.web.js is served correctly -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!-- Why: test projects live under public/tests/; exclude them from the app's default .cs/.razor
         globs so the Web SDK doesn't sweep xUnit/bUnit test files into the app build (CS0246). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <!-- Why: the sidebar footer previously showed the stale UI assembly version. Bake the FDW
         platform version this UI is built against into InformationalVersion so the footer surfaces
         a meaningful, accurate version instead. -->
    <Version>1.0.0-rc.1</Version>
    <InformationalVersion>1.0.0-rc.1</InformationalVersion>
  </PropertyGroup>

  <!-- Define DEVELOP symbol for *-Local configurations (enables dev credentials UI) -->
  <PropertyGroup Condition="$(Configuration.EndsWith('-Local'))">
    <DefineConstants>$(DefineConstants);DEVELOP</DefineConstants>
  </PropertyGroup>

  <!-- Tailwind CSS Build
       Resolves the binary in order:
         1. project-local tailwindcss.exe  (developer copy / CI before_script drop-in)
         2. /usr/local/bin/tailwindcss     (permanently installed on the CI shell runner)
  -->
  <PropertyGroup>
    <TailwindExe Condition="Exists('$(MSBuildProjectDirectory)/tailwindcss.exe')">$(MSBuildProjectDirectory)/tailwindcss.exe</TailwindExe>
    <TailwindExe Condition="'$(TailwindExe)' == '' AND Exists('/usr/local/bin/tailwindcss')">/usr/local/bin/tailwindcss</TailwindExe>
  </PropertyGroup>
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="'$(TailwindExe)' != ''">
    <Message Importance="high" Text="Building Tailwind CSS using $(TailwindExe)..." />
    <Exec Command="$(TailwindExe) -i Styles/input.css -o wwwroot/css/app.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="WatchTailwind" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Message Importance="high" Text="Run 'tailwindcss.exe -i Styles/input.css -o wwwroot/css/app.css --watch' for live CSS updates" />
  </Target>

  <ItemGroup>
    <!-- Fdw packages -->
    <PackageReference Include="Fdw.MessageLogging.Abstractions" />
    <PackageReference Include="Fdw.Services.Registration" />
    <PackageReference Include="Fdw.Services.Registration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.MessageLogging.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- Generates [ModuleInitializer] to register all cross-assembly ServiceTypeOptions/TypeOptions before Main() -->
    <PackageReference Include="Fdw.Registration.SourceGenerators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Fdw.Services.SessionState.Clients" />
    <PackageReference Include="Fdw.UI" />
    <PackageReference Include="Fdw.Web.Clients.Abstractions" />

    <!-- Fdw Authentication -->
    <PackageReference Include="Fdw.Web.Http.Authentication.Blazor" />
    <PackageReference Include="Fdw.UI.Blazor.Authentication" />

    <!-- Per-Domain API Clients -->
    <PackageReference Include="Fdw.Services.Connections.Clients" />
    <PackageReference Include="Fdw.Services.Data.Clients" />
    <PackageReference Include="Fdw.Services.Multitenancy.Components" />
    <PackageReference Include="Fdw.Services.Catalog.Clients" />
    <PackageReference Include="Fdw.Operations.Clients" />
    <PackageReference Include="Fdw.Schema.Clients" />
    <PackageReference Include="Fdw.UI.Components" />
    <PackageReference Include="Fdw.Dashboard.UI.Components" />
    <!-- Why: consolidated UI.Pages replaces all per-domain *.UI.Pages, *.UI.Components, *.Clients,
         *.Components packages that were removed in rc.2-reorg. -->
    <PackageReference Include="Fdw.UI.Pages" />
    <!-- ETL abstractions: replaces removed Services.Etl.Projects.Clients + .Clients.Abstractions -->
    <PackageReference Include="Fdw.Services.Etl.Abstractions" />
    <PackageReference Include="Fdw.UI.Themes.Clients" />
    <PackageReference Include="Fdw.Web.Search.Clients" />
    <PackageReference Include="Fdw.Web.Calculations.Clients" />
    <PackageReference Include="Fdw.Web.Analytics.Clients" />
    <PackageReference Include="Fdw.UI.Pipelines.Clients.Abstractions" />

    <!-- Third-party packages -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- Why: the SERVICE-TYPE package, not the aggregation. A package reference IS a
     registration, so this is how the host declares it wants MsSql connections
     registered; it brings ReferenceConnections.MsSql (the aggregation) transitively. -->
    <PackageReference Include="ReferenceSecretManagers.EnvironmentVariable" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fdw Per-Domain Component Packages (Wave 2) -->
    <PackageReference Include="Fdw.Data.Components" />
    <PackageReference Include="Fdw.Schema.Components" />
    <PackageReference Include="Fdw.Operations.Components" />
    <PackageReference Include="Fdw.Services.Pipelines.Components" />
    <!-- Fdw Per-Domain Component Packages (Wave 3 — provider migration) -->
    <PackageReference Include="Fdw.Services.Connections.Components" />
    <PackageReference Include="Fdw.Services.Scheduling.Components" />
    <PackageReference Include="Fdw.UI.Themes.Components" />
    <PackageReference Include="Fdw.Web.Analytics.Components" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fdw.Services.SessionState.Components" />
    <PackageReference Include="Fdw.Services.Data.Abstractions" />
    <PackageReference Include="Fdw.Calculations.Abstractions" />
    <PackageReference Include="Fdw.Data.DataContainers.Abstractions" />
    <PackageReference Include="Fdw.UI.Themes.Abstractions" />
    <PackageReference Include="Fdw.UI.Themes" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why (FDW-578): DIRECT FileSystem-backed IConfigurationGateway for SecretManager config, so the
         UI can read+write config without the reference-api HTTP hop. FileSystem is a folder of JSON
         files, not a database — this preserves the "no server-core DB" posture while reusing the exact
         same IConfigurationGateway mechanism every other app uses. Mirrors Reference.Api's MsSql wiring. -->
    <PackageReference Include="Fdw.Services.Data" />
    <PackageReference Include="Fdw.Services.Connections.FileSystem" />
    <PackageReference Include="Fdw.Services.SecretManagers" />
    <!-- Why: registers the "Json" RecordSource so the FileSystem connection can parse Format:"Json"
         container files (else RecordSourceTypes.ByName("Json") is NotFound). Same reason Reference.Api
         references it directly. -->
    <PackageReference Include="Fdw.Data.RowSources.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Why (FDW-578): the FileSystem config gateway loads configurationSchema.json (resolved against
         AppContext.BaseDirectory) and reads its container rows from config-data/**. Ship both to the
         output so the gateway finds them at runtime — mirrors Reference.Api's configurationSchema.json
         Content entry. -->
    <Content Update="configurationSchema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="config-data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
