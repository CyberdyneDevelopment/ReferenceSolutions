@* TransformTypeSelector — modal overlay for selecting which transform type to add.
   Groups available types by category with section headers. *@

<!-- Backdrop -->
<div class="fixed inset-0 z-40 bg-black/60" @onclick="OnClose"></div>

<!-- Modal -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-gray-900 border border-gray-700 rounded-lg shadow-2xl w-full max-w-lg max-h-[80vh] flex flex-col" @onclick:stopPropagation="true">
        <!-- Header -->
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-700">
            <h3 class="text-base font-bold text-gray-200 uppercase tracking-widest">Add Transform</h3>
            <button class="p-1 text-gray-500 hover:text-gray-300" @onclick="OnClose">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Search -->
        <div class="px-5 py-3 border-b border-gray-700/50">
            <input class="input w-full" placeholder="Search transforms..." @bind="_searchText" @bind:event="oninput" />
        </div>

        <!-- Type list grouped by category -->
        <div class="flex-1 overflow-y-auto px-5 py-3 space-y-4">
            @if (FilteredGroups.Count == 0)
            {
                <p class="text-sm text-gray-500 text-center py-6">No transforms match your search.</p>
            }
            else
            {
                @foreach (var group in FilteredGroups)
                {
                    <div>
                        <div class="text-[10px] uppercase tracking-widest text-gray-500 font-medium mb-2">@group.Key</div>
                        <div class="space-y-1">
                            @foreach (var type in group.Value)
                            {
                                <button class="w-full text-left px-3 py-2.5 rounded bg-gray-800/50 border border-gray-700/50 hover:border-gray-600 hover:bg-gray-800 transition-colors group"
                                        @onclick="() => SelectType(type.Name)">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-medium text-gray-200 group-hover:text-white">@type.DisplayName</span>
                                            @if (type.Parameters.Count > 0)
                                            {
                                                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-gray-700 text-gray-400">@type.Parameters.Count param@(type.Parameters.Count != 1 ? "s" : "")</span>
                                            }
                                            @if (type.SupportsBatching)
                                            {
                                                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-500">batch</span>
                                            }
                                        </div>
                                        <svg class="w-4 h-4 text-gray-600 group-hover:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                        </svg>
                                    </div>
                                    @if (!string.IsNullOrEmpty(type.Description))
                                    {
                                        <p class="text-xs text-gray-500 mt-1">@type.Description</p>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TransformTypePayload> AvailableTypes { get; set; } = [];
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _searchText = string.Empty;

    private static readonly string[] CategoryOrder = ["String", "Numeric", "DateTime", "Boolean", "Conditional", "Injection"];

    private Dictionary<string, List<TransformTypePayload>> FilteredGroups
    {
        get
        {
            var filtered = string.IsNullOrWhiteSpace(_searchText)
                ? AvailableTypes
                : AvailableTypes.Where(t =>
                    t.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    t.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    t.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

            return filtered
                .GroupBy(t => string.IsNullOrEmpty(t.Category) ? "Other" : t.Category)
                .OrderBy(g => Array.IndexOf(CategoryOrder, g.Key) is var idx && idx >= 0 ? idx : CategoryOrder.Length)
                .ToDictionary(g => g.Key, g => g.OrderBy(t => t.DisplayName, StringComparer.OrdinalIgnoreCase).ToList());
        }
    }

    private async Task SelectType(string typeName)
    {
        await OnSelect.InvokeAsync(typeName);
    }
}
