@namespace Reference.Ui.Components.Domain.Tenants
@using Microsoft.AspNetCore.Components
@using System

@* Why: Tailwind skin for the tenant multi-select filter.
   Only visible in cross-tenant mode (ctx.IsVisible). Single-tenant users see nothing. *@

<TenantMultiSelectProvider>
    <ChildContent Context="ctx">
        @if (ctx.IsVisible)
        {
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs text-gray-500 font-mono uppercase tracking-widest shrink-0">Tenants:</span>

                @if (ctx.IsLoading)
                {
                    <span class="text-xs text-gray-500 font-mono">Loading...</span>
                }
                else if (!string.IsNullOrEmpty(ctx.ErrorMessage))
                {
                    <span class="text-xs text-red-400 font-mono">@ctx.ErrorMessage</span>
                }
                else
                {
                    @* Per-tenant toggle chips *@
                    @foreach (var tenant in ctx.AvailableTenants)
                    {
                        var isSelected = ctx.SelectedTenantIds.Contains(tenant.Id);
                        <button type="button"
                                class="px-2 py-0.5 text-xs font-mono border transition-colors @(isSelected
                                    ? "border-red-500/70 bg-red-500/10 text-red-400 hover:bg-red-500/20"
                                    : "border-gray-700 bg-transparent text-gray-600 hover:border-gray-500 hover:text-gray-400")"
                                title="@(isSelected ? "Exclude" : "Include") @tenant.Name"
                                @onclick="() => ctx.OnToggleTenant(tenant.Id)">
                            @tenant.Name
                        </button>
                    }

                    @* All / Clear controls *@
                    <button type="button"
                            class="px-2 py-0.5 text-[10px] font-mono text-gray-500 hover:text-gray-300 border border-transparent hover:border-gray-700 transition-colors"
                            @onclick="() => ctx.OnSelectAll()">
                        ALL
                    </button>
                    <button type="button"
                            class="px-2 py-0.5 text-[10px] font-mono text-gray-500 hover:text-gray-300 border border-transparent hover:border-gray-700 transition-colors"
                            @onclick="() => ctx.OnClearAll()">
                        CLEAR
                    </button>
                }
            </div>
        }
    </ChildContent>
</TenantMultiSelectProvider>
