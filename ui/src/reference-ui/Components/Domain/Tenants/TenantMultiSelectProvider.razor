@namespace Reference.Ui.Components.Domain.Tenants
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Net.Http
@using System.Security.Claims
@using System.Threading
@using System.Threading.Tasks
@using Fdw.Services.Multitenancy.Clients
@using Fdw.Services.Multitenancy.Clients.Models
@using Reference.Ui.Logging

@* Why: Headless provider for the cross-tenant multi-select filter.
   Only mounts (loads) tenant list when the active session is in cross-tenant mode.
   Single-tenant consumers do not see this — check ctx.IsVisible before rendering. *@

@if (ChildContent is not null)
{
    @ChildContent(_context)
}

@code {
    [Parameter]
    public RenderFragment<TenantMultiSelectContext>? ChildContent { get; set; }

    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILoggerFactory? LoggerFactory { get; set; }
    [Inject] private ILogger<TenantMultiSelectProvider>? LoggerParam { get; set; }

    private ILogger<TenantMultiSelectProvider> _logger = NullLogger<TenantMultiSelectProvider>.Instance;
    private TenantApiClient? _tenantApi;

    private IReadOnlyList<TenantSummaryPayload> _availableTenants = [];
    private HashSet<Guid> _selectedTenantIds = new();
    private bool _isVisible;
    private bool _isLoading;
    private string? _errorMessage;
    private bool _initialized;

    private TenantMultiSelectContext _context = new();

    protected override void OnInitialized()
    {
        _logger = LoggerParam ?? NullLogger<TenantMultiSelectProvider>.Instance;
        _tenantApi = new TenantApiClient(
            HttpClientFactory.CreateClient("TenantClient"),
            LoggerFactory?.CreateLogger<TenantApiClient>() ?? NullLogger<TenantApiClient>.Instance);
        RebuildContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        await Load();
    }

    private async Task Load(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _errorMessage = null;
        RebuildContext();
        StateHasChanged();

        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (principal.Identity?.IsAuthenticated != true)
            {
                _isVisible = false;
                _availableTenants = [];
                return;
            }

            // Only show multi-select when the user is in cross-tenant mode
            // (tenant_id claim is absent or empty)
            var tenantIdRaw = principal.FindFirst("tenant_id")?.Value;
            var isCrossTenant = string.IsNullOrEmpty(tenantIdRaw);

            if (!isCrossTenant)
            {
                _isVisible = false;
                _availableTenants = [];
                return;
            }

            _isVisible = true;
            TenantLog.LoadingTenants(_logger);

            var result = await _tenantApi!.GetTenants(false, cancellationToken);
            if (!result.IsSuccess)
            {
                _errorMessage = TenantLog.LoadTenantsFailed(
                    _logger, new InvalidOperationException(result.CurrentMessage ?? "API returned failure")).Message;
                _availableTenants = [];
                _isLoading = false;
                RebuildContext();
                StateHasChanged();
                return;
            }

            _availableTenants = result.Value ?? [];
            TenantLog.LoadedTenants(_logger, _availableTenants.Count);

            // Start with all tenants selected (show everything)
            _selectedTenantIds = new HashSet<Guid>(_availableTenants.Select(t => t.Id));
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _errorMessage = TenantLog.LoadTenantsFailed(_logger, ex).Message;
            _availableTenants = [];
        }
        finally
        {
            _isLoading = false;
            RebuildContext();
            StateHasChanged();
        }
    }

    private void HandleToggleTenant(Guid tenantId)
    {
        if (!_selectedTenantIds.Remove(tenantId))
            _selectedTenantIds.Add(tenantId);
        RebuildContext();
        StateHasChanged();
    }

    private void HandleSelectAll()
    {
        _selectedTenantIds = new HashSet<Guid>(_availableTenants.Select(t => t.Id));
        RebuildContext();
        StateHasChanged();
    }

    private void HandleClearAll()
    {
        _selectedTenantIds = new HashSet<Guid>();
        RebuildContext();
        StateHasChanged();
    }

    private void RebuildContext()
    {
        _context = new TenantMultiSelectContext
        {
            AvailableTenants = _availableTenants,
            SelectedTenantIds = _selectedTenantIds,
            IsVisible = _isVisible,
            IsLoading = _isLoading,
            ErrorMessage = _errorMessage,
            OnToggleTenant = HandleToggleTenant,
            OnSelectAll = HandleSelectAll,
            OnClearAll = HandleClearAll
        };
    }
}
