@inject NavigationManager Navigation
@inject ILogger<NavItem> Logger

@if (_route.IsSuccess)
{
    <a href="@Href" class="@GetNavClass()">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
            @GetIconPath()
        </svg>
        @Text
    </a>
}
else
{
    @* Why: a page that declares a sidebar entry but no route it can link to is a declaration error. It
       renders in place, disabled and marked, so the mistake is visible instead of silently dropped —
       and one bad declaration costs one entry rather than the whole sidebar. *@
    <span class="nav-item nav-item-broken" title="@_route.CurrentMessage">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
            @GetIconPath()
        </svg>
        @Text (unreachable)
    </span>
}

@code {
    // Why: takes the page, not its fields spread across three parameters — adding anything to a page's
    // declaration then costs no change here. The route is READ FROM THE COMPONENT's [Route] attribute
    // (what @page compiles to) rather than being declared a second time, so a page whose route moves
    // cannot leave a stale sidebar link behind.
    [Parameter, EditorRequired] public Fdw.UI.Navigation.IPage Page { get; set; } = default!;

    // Why: NavTree.Build already excluded pages whose NavItem is Empty, so these are read directly —
    // no null guard, and nothing to throw about. The route is resolved by PageRoutes, which reports a
    // bad declaration through MessageLogging rather than throwing in the render path (a throw here
    // would tear down the whole sidebar over one mis-declared page).
    private Fdw.Results.IGenericResult<string> _route = default!;

    private string Href => _route.Value!;
    private string Icon => Page.NavItem.Icon;
    private string Text => Page.NavItem.Label;

    // Why: resolved once per parameter set rather than on every property read, so the failure is logged
    // once for a bad declaration instead of on each re-render.
    protected override void OnParametersSet() => _route = PageRoutes.NavRoute(Page, Logger);

    private bool IsActive()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrEmpty(currentPath) && Href == "/") return true;
        if (Href != "/" && ("/" + currentPath).StartsWith(Href)) return true;
        return false;
    }

    private string GetNavClass() => IsActive() ? "nav-item active" : "nav-item";

