@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Sign in - CyberdyneDevelopment</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/login.css" />
</HeadContent>

<div class="lwrap">
    <section class="brandpane">
        <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        <div class="bp-top">
            <svg viewBox="0 0 64 64" fill="none">
                <rect x="16" y="11" width="32" height="6" fill="#d99a3f" />
                <rect x="12" y="21" width="40" height="6" fill="#ece8e0" />
                <rect x="8" y="31" width="48" height="6" fill="#ece8e0" /><rect x="29" y="31" width="6" height="6" fill="#e05c4a" />
                <rect x="8" y="41" width="48" height="6" fill="#ece8e0" />
                <rect x="8" y="51" width="48" height="4" fill="#66614f" />
            </svg>
            <div class="wm"><b>Cyberdyne<span class="dev">Development</span></b><span>REFERENCE CONSOLE</span></div>
        </div>
        <div class="bp-mid">
            <div class="ey">AI Safety Infrastructure · Mk. I</div>
            <h1>The control plane for data that has to <em>behave</em>.</h1>
            <p>Connections, pipelines, lineage and quality for every tenant — running on Fdw, under supervision.</p>
        </div>
        <div class="bp-bottom">
            <div class="bp-stat"><span class="led green"></span><b>All systems nominal</b> · services healthy</div>
            <div class="bp-stat"><span class="led"></span><b>Supervised</b> · human-in-the-loop</div>
        </div>
    </section>

    <section class="formpane">
        <form method="post" action="/auth/login" data-enhance="false" class="signin">
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <div class="head">
                <h2>Sign in</h2>
                <p>Authenticate to the reference console.</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="login-err">@_errorMessage</div>
            }

            @if (ShowDevLogin)
            {
            <div class="login-dev">
                <div class="dl">Dev — quick login</div>
                <div class="inp">
                    <select id="devUserSelect"
                            onchange="(function(sel){var o=sel.options[sel.selectedIndex];if(o.dataset.username){document.getElementById('username').value=o.dataset.username;document.getElementById('password').value=o.dataset.password;}})(this)">
                        <option value="">Select test user…</option>
                        @foreach (var user in _devCredentials)
                        {
                            <option value="@user.Username" data-username="@user.Username" data-password="@user.Password">@user.Username (@user.Role)</option>
                        }
                    </select>
                </div>
            </div>
            }

            <div class="field">
                <label for="username">Identity</label>
                <div class="inp">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 12a4 4 0 100-8 4 4 0 000 8zM4 20a8 8 0 0116 0" /></svg>
                    <input type="text" id="username" name="username" placeholder="Enter ID…" required autocomplete="username" />
                </div>
            </div>

            <div class="field">
                <label for="password">Passcode <a href="/forgot-password">Forgot?</a></label>
                <div class="inp">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 10V8a6 6 0 1112 0v2M5 10h14v10H5z" /></svg>
                    <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
                    <button type="button" class="eye"
                            onclick="(function(b){var i=b.parentElement.querySelector('input');i.type=i.type==='password'?'text':'password';})(this)">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width:16px;height:16px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
            </div>

            <div class="field">
                <label for="tenant">Tenant</label>
                <div class="inp">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4h14v5H5zM5 11h14v5H5z" /></svg>
                    <input type="text" id="tenant" name="tenant" placeholder="Optional" />
                </div>
            </div>

            <button type="submit" class="btn-auth">
                Sign in
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>

            <div class="foot">
                <span>© MMXXVI CYBERDYNEDEVELOPMENT</span>
                <span>TLS 1.3</span>
            </div>
        </form>
    </section>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private sealed record DevCredential(string Username, string Password, string Role);

    private string? _errorMessage;
    private string _returnUrl = "/";

    // Why: razor MARKUP cannot be guarded by C# preprocessor directives (a bare "#if" line in
    // markup renders as literal text and the block always compiles — CS0103 in Release when the
    // field was compiled out). The markup is guarded at runtime by ShowDevLogin instead, and only
    // DEVELOP (-Local) builds carry the credential data — a Release binary ships an empty list.
#if DEVELOP
    private static bool ShowDevLogin => true;

    // Why: Must match databases/AuthDb/seed/00-seed-auth-secrets.sql. Passwords end in "1#".
    private List<DevCredential> _devCredentials = new()
    {
        new("admin", "AdminPassword1#", "Admin"),
        new("testuser", "TestPassword1#", "Test User"),
        new("afcuser", "AfcPassword1#", "AFC"),
        new("nfcuser", "NfcPassword1#", "NFC"),
    };
#else
    private static bool ShowDevLogin => false;

    private List<DevCredential> _devCredentials = new();
#endif

    protected override void OnInitialized()
    {
        // Parse error and returnUrl from query string
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var error = query["error"];
        _returnUrl = query["returnUrl"] ?? "/";

        _errorMessage = error switch
        {
            "invalid-credentials" => "ACCESS DENIED: Invalid credentials",
            "server-error" => "ACCESS DENIED: Server error occurred",
            _ => null
        };
    }
}
